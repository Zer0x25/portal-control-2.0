{
  "name": "new-portal-control-ver-3-0",
  "description": "BMW buscando el Ferrari (Estatus employee)",
  "private": true,
  "version": "8.10.0",
  "type": "module",
  "engines": {
    "node": ">=26 <27"
  },
  "scripts": {
    "audit:design-system": "node scripts/audit-design-system.cjs",
    "audit:lighthouse": "lhci autorun --config=.lighthouserc.json",
    "audit:memoization": "node scripts/audit-memoization.mjs",
    "build": "npm run check:font-subsets && vite build",
    "catalog:manifest": "node scripts/build-design-system-manifest.cjs",
    "catalog:manifest:check": "node scripts/build-design-system-manifest.cjs --check",
    "check": "tsc --noEmit",
    "check:bundle-budget": "node scripts/check-bundle-budget.cjs",
    "check:storybook-runtime": "node scripts/check-storybook-runtime.cjs",
    "dev": "vite",
    "e2e": "playwright test",
    "e2e:headed": "playwright test --headed",
    "e2e:install": "playwright install",
    "e2e:staging": "E2E_BASE_URL=http://127.0.0.1:8080 E2E_API_URL=http://127.0.0.1:8080/api playwright test",
    "perf:staging": "node scripts/run-performance-battery.cjs",
    "e2e:ui": "playwright test --ui",
    "e2e:visual": "playwright test --project visual",
    "e2e:visual:update": "playwright test --project visual --update-snapshots",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,md}\"",
    "guardrails": "npm run lint:guardrails && npm run test:guardrails",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "lint:guardrails": "eslint src/tests/guardrails/frontendAuditGuardrails.test.ts src/tests/guardrails/datePickerGuardrails.test.ts src/tests/guardrails/designSystemGuardrails.test.ts src/tests/guardrails/formTableGuardrails.test.ts src/tests/guardrails/httpClientGuardrails.test.ts src/tests/guardrails/iconDuplicates.test.ts src/tests/guardrails/metricCardGuardrails.test.ts src/tests/guardrails/modalGuardrails.test.ts src/tests/guardrails/queryKeysGuardrails.test.ts src/tests/guardrails/spinnerGuardrails.test.ts src/tests/guardrails/stateBoundaryGuardrails.test.ts src/tests/guardrails/statusTokensContrast.test.ts src/tests/guardrails/tabSystemGuardrails.test.ts src/tests/guardrails/typographyGuardrails.test.ts src/tests/guardrails/uiLayeringGuardrails.test.ts src/tests/guardrails/viewPurityGuardrails.test.ts src/tests/guardrails/zScaleGuardrails.test.ts",
    "measure:renders": "node scripts/measure-renders.mjs",
    "preview": "vite preview",
    "sdk:generate": "openapi-typescript ../backend/docs/swagger.json -o src/types/api-schema.ts && prettier --write src/types/api-schema.ts",
    "storybook": "PORTAL_SKIP_PWA=1 storybook dev --host 127.0.0.1 --port 6006",
    "storybook:build": "npm run catalog:manifest:check && PORTAL_SKIP_PWA=1 storybook build",
    "storybook:visual": "playwright test --config=playwright.storybook.config.ts",
    "storybook:visual:update": "playwright test --config=playwright.storybook.config.ts --update-snapshots",
    "test": "vitest",
    "test:browser": "vitest run --project browser",
    "test:coverage": "vitest run --coverage",
    "test:guardrails": "vitest run src/tests/guardrails/frontendAuditGuardrails.test.ts src/tests/guardrails/datePickerGuardrails.test.ts src/tests/guardrails/designSystemGuardrails.test.ts src/tests/guardrails/formTableGuardrails.test.ts src/tests/guardrails/httpClientGuardrails.test.ts src/tests/guardrails/iconDuplicates.test.ts src/tests/guardrails/metricCardGuardrails.test.ts src/tests/guardrails/modalGuardrails.test.ts src/tests/guardrails/queryKeysGuardrails.test.ts src/tests/guardrails/spinnerGuardrails.test.ts src/tests/guardrails/stateBoundaryGuardrails.test.ts src/tests/guardrails/statusTokensContrast.test.ts src/tests/guardrails/tabSystemGuardrails.test.ts src/tests/guardrails/typographyGuardrails.test.ts src/tests/guardrails/uiLayeringGuardrails.test.ts src/tests/guardrails/viewPurityGuardrails.test.ts src/tests/guardrails/zScaleGuardrails.test.ts",
    "test:jsdom": "vitest run --project jsdom",
    "test:perf": "node scripts/measure-inner-perf.cjs",
    "test:run": "vitest run",
    "test:run:ci": "node scripts/run-frontend-tests.cjs",
    "tokens:build": "node scripts/build-tokens.cjs --write",
    "tokens:check": "node scripts/build-tokens.cjs --check",
    "validate:ci": "npm run format:check && npm run lint && node ../scripts/lint-budget.cjs --only frontend && npm run check && npm run test:run:ci && npm run catalog:manifest:check && npm run tokens:check && npm run audit:design-system && npm run storybook:build && npm run build && npm run check:storybook-runtime && npm run check:bundle-budget",
    "validate:ci:coverage": "npm run format:check && npm run lint && node ../scripts/lint-budget.cjs --only frontend && npm run check && npm run test:coverage && npm run catalog:manifest:check && npm run tokens:check && npm run audit:design-system && npm run storybook:build && npm run build && npm run check:storybook-runtime && npm run check:bundle-budget",
    "check:font-subsets": "node scripts/check-font-subsets.cjs"
  },
  "dependencies": {
    "@sentry/browser": "^11.1.0",
    "@sentry/react": "^11.4.0",
    "@tanstack/query-async-storage-persister": "^5.104.1",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.90.20",
    "@tanstack/react-query-devtools": "^5.91.3",
    "@tanstack/react-query-persist-client": "^5.104.1",
    "@tanstack/react-table": "^9.3.1",
    "@tanstack/react-virtual": "^3.13.18",
    "chart.js": "^4.5.1",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "dompurify": "^3.3.2",
    "idb": "^8.0.0",
    "nanoid": "^6.0.1",
    "react": "^19.3.0",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "socket.io-client": "^4.8.3",
    "ulid": "^3.0.2",
    "web-vitals": "^6.2.3",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@babel/plugin-transform-runtime": "^7.29.7",
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.58.2",
    "@storybook/addon-a11y": "10.6.3",
    "@storybook/react-vite": "10.6.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/browser": "^5.0.3",
    "@vitest/browser-playwright": "^5.0.3",
    "@vitest/coverage-v8": "^5.0.3",
    "ajv": "^8.20.0",
    "autoprefixer": "^10.4.21",
    "axe-core": "~4.13.0",
    "cssnano": "^9.2.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.3.0",
    "jsdom": "^30.1.1",
    "msw": "^2.15.0",
    "openapi-typescript": "^7.13.0",
    "oxc-transform-react": "^0.155.0",
    "postcss": "^8.4.49",
    "prettier": "^3.8.1",
    "puppeteer-core": "^25.16.0",
    "storybook": "10.6.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.3.3",
    "vite": "^8.3.2",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^5.0.3"
  }
}
