{
  "name": "new-portal-control-ver-3-0",
  "description": "BMW buscando el Ferrari (Estatus employee)",
  "private": true,
  "version": "8.10.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:guardrails": "vitest run src/tests/guardrails/frontendAuditGuardrails.test.ts",
    "test:run:ci": "node scripts/run-frontend-tests.cjs",
    "e2e": "playwright test",
    "e2e:headed": "playwright test --headed",
    "e2e:ui": "playwright test --ui",
    "e2e:install": "playwright install",
    "check": "tsc --noEmit",
    "lint": "eslint src",
    "lint:guardrails": "eslint src/tests/guardrails/frontendAuditGuardrails.test.ts",
    "lint:fix": "eslint src --fix",
    "guardrails": "npm run lint:guardrails && npm run test:guardrails",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,md}\"",
    "test:perf": "node scripts/measure-inner-perf.cjs",
    "sdk:generate": "openapi-typescript ../backend/docs/swagger.json -o src/types/api-schema.ts && prettier --write src/types/api-schema.ts",
    "validate:ci": "npm run format:check && npm run lint && node ../scripts/lint-budget.cjs --only frontend && npm run check && npm run test:run:ci && npm run build"
  },
  "dependencies": {
    "@sentry/browser": "^11.1.0",
    "@sentry/react": "^10.38.0",
    "@tanstack/react-query": "^5.90.20",
    "@tanstack/react-query-devtools": "^5.91.3",
    "@tanstack/react-virtual": "^3.13.18",
    "axios": "^1.13.4",
    "chart.js": "^4.5.1",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "dompurify": "^3.3.2",
    "framer-motion": "^12.23.0",
    "idb": "^8.0.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.7",
    "nanoid": "^5.0.7",
    "react": "^19.3.0",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.3.0",
    "react-router": "^7.6.3",
    "react-router-dom": "^7.18.4",
    "socket.io-client": "^4.8.3",
    "ulid": "^2.3.0",
    "zod": "^3.23.8",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^5.0.2",
    "autoprefixer": "^10.4.21",
    "cssnano": "^7.1.2",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "globals": "^17.3.0",
    "jsdom": "^30.1.1",
    "openapi-typescript": "^7.13.0",
    "postcss": "^8.4.49",
    "prettier": "^3.8.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.3.3",
    "vite": "^7.0.6",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^3.2.4"
  }
}
