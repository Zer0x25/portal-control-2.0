# Configuración del Frontend para Producción

# URL del API Backend
# Si se despliega detrás de Nginx (mismo origen), puedes omitir esta variable y se usará `/api` automáticamente.
# Si usas un dominio separado para el backend, incluye el sufijo `/api`.
VITE_API_URL="http://localhost:4000/api"

# Entorno
VITE_NODE_ENV=production

# Animaciones UI globales ("true" habilita AnimatePresence y motion completo)
VITE_ENABLE_UI_ANIMATIONS=true

# Modo de performance de UI (high | low)
VITE_UI_PERF_MODE=high

# Sentry (opcional en local)
VITE_SENTRY_DSN=
