# Variables del staging local (compose.staging.yaml).
# Copiar a `.env.staging` (ignorado por git) y completar los secretos.
#   docker compose --env-file .env.staging -f compose.staging.yaml up --build -d

# --- Secretos (OBLIGATORIOS, sin valor por defecto) ---
# Generar con: openssl rand -hex 32
JWT_SECRET=
# Contraseña del usuario admin que crea el seed en modo producción.
SEED_ADMIN_PASSWORD=

# better-auth (strangler fig; false = legacy JWT)
BETTER_AUTH_URL=http://localhost:8080/api/auth
BETTER_AUTH_SECRET=
BETTER_AUTH_ENABLED=false
VITE_BETTER_AUTH_ENABLED=false

# --- Puertos del host (solo loopback) ---
STAGING_PORT=8080
STAGING_DB_HOST_PORT=5434

# --- Base de datos (propia, distinta de dev `pweb3_dev` y prod `pweb3`) ---
DB_USER=postgres
DB_PASSWORD=password
DB_NAME=pweb3_staging

# --- CORS: debe incluir el origen con el que abres el gateway ---
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# --- Opcionales ---
BACKUP_ENABLED=false
DISABLE_INTEGRITY_AUDIT=false
# Ensayos aislados pueden desactivar la consulta externa de feriados.
DISABLE_HOLIDAY_AUTOSYNC=false
# EMAIL_HOST=
# EMAIL_PORT=587
# EMAIL_USER=
# EMAIL_PASS=
