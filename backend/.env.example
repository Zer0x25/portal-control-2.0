# Configuración del Backend para Producción

# URLs
# Note: In hybrid Windows-to-Docker setups, use localhost:6432 for PgBouncer.
# For standard connection:
# DATABASE_URL="postgresql://postgres:password@localhost:5432/pweb3?schema=public"
# For PgBouncer connection (Transaction Mode):
DATABASE_URL="postgresql://postgres:password@localhost:6432/pweb3?schema=public&pgbouncer=true"
# For Prisma Migrations (Direct to DB, bypassing PgBouncer):
DIRECT_URL="postgresql://postgres:password@localhost:5432/pweb3?schema=public"
# Dedicated integration test database (preferred for `npm run test:integration`)
TEST_DATABASE_URL="postgresql://postgres:password@localhost:5432/pweb3_test?schema=public"
# Optional direct URL for test migrations; falls back to DIRECT_URL when missing
TEST_DIRECT_URL="postgresql://postgres:password@localhost:5432/pweb3_test?schema=public"

# Seguridad
JWT_SECRET=cambiame_por_algo_muy_largo_y_aleatorio
NODE_ENV=development
# Pausa la auditoria de integridad automatica (recomendado solo en desarrollo local).
DISABLE_INTEGRITY_AUDIT=false
# Pausa la sincronizacion automatica de feriados en el arranque.
DISABLE_HOLIDAY_AUTOSYNC=false
INTEGRITY_BROKEN_LOG_THRESHOLD=100
INTEGRITY_BROKEN_SAMPLE_SIZE=20
INTEGRITY_BULK_ALERT_COOLDOWN_MINUTES=60
INTEGRITY_BACKFILL_ENABLED=true
INTEGRITY_BACKFILL_BATCH_SIZE=8000
INTEGRITY_BACKFILL_WORKERS=16
# Limite de registros a procesar por tanda nocturna (-1 para ilimitado).
INTEGRITY_BACKFILL_MAX_PER_RUN=-1
INTEGRITY_AUTO_RECHAIN_ENABLED=false
INTEGRITY_RECHAIN_MAX_EMPLOYEES_PER_RUN=200
INTEGRITY_RECHAIN_VERIFY_LIMIT=-1

# Email (Nodemailer)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=tu-email@gmail.com
EMAIL_PASS=tu-password-de-aplicacion
# Seguridad TLS (evita MITM). Solo usar `true` si el SMTP usa certificados no confiables en red interna.
SMTP_ALLOW_INSECURE_TLS=false

# CORS
ALLOWED_ORIGINS="https://tu-dominio.com,http://localhost:5173"

# URL pública del API para el spec de Swagger (agnóstica por entorno).
# Sin esta variable el spec usa http://localhost:4000 (dev).
#PUBLIC_API_URL="https://api.tu-dominio.com"

# Backup
BACKUP_ENABLED=false

# Shift rotation hardening
DISABLE_SHIFT_ROTATION=false
SHIFT_ROTATION_MAX_PER_RUN=50
SHIFT_ROTATION_RETRY_COUNT=2
SHIFT_ROTATION_RETRY_DELAY_MS=300
SHIFT_ROTATION_TX_MAX_WAIT_MS=5000
SHIFT_ROTATION_TX_TIMEOUT_MS=10000
SHIFT_ROTATION_AUDIT_PER_ITEM=false
BACKUP_COMPRESS=true
BACKUP_MODE=auto
BACKUP_DOCKER_CONTAINER=
BACKUP_PATH=./backups
BACKUP_SCHEDULE_HOUR=2
BACKUP_SCHEDULE_MINUTE=0
BACKUP_STALE_HOURS=26
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=8
BACKUP_KEEP_MONTHLY=12

# Seeder (solo dev/demo)
# SEED_ADMIN_PASSWORD=cambia_esto
SEED_PHASE2_DAY_TIMEOUT_MS=600000
