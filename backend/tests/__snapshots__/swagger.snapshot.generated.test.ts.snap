    "/api/meters": {
      "get": {
        "parameters": [
          {
            "in": "query",
            "name": "page",
            "schema": {
              "maximum": 1000000,
              "minimum": 1,
              "type": "integer",
            },
          },
          {
            "in": "query",
            "name": "pageSize",
            "schema": {
              "maximum": 500,
              "minimum": 1,
              "type": "integer",
            },
          },
          {
            "description": "Mes de Chile, excluyente con startDate/endDate",
            "in": "query",
            "name": "month",
            "schema": {
              "pattern": "^\\d{4}-(0[1-9]|1[0-2])$",
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "meterId",
            "schema": {
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "startDate",
            "schema": {
              "format": "date",
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "endDate",
            "schema": {
              "format": "date",
              "type": "string",
            },
          },
          {
            "description": "Timestamp para consulta delta",
            "in": "query",
            "name": "since",
            "schema": {
              "type": "string",
            },
          },
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/PaginatedMeterReadingResponse",
                    },
                    {
                      "$ref": "#/components/schemas/MeterReadingListResponse",
                    },
                  ],
                },
              },
            },
            "description": "Lista de lecturas",
          },
        },
        "security": [
          {
            "bearerAuth": [],
          },
        ],
        "summary": "Obtiene lecturas de medidores (soporta paginación)",
        "tags": [
          "Meters",
        ],
      },
    },
    "/api/meters/bulk": {
      "post": {
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "items": {
                  "$ref": "#/components/schemas/MeterReading",
                },
                "type": "array",
              },
            },
          },
          "required": true,
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeterReadingListResponse",
                },
              },
            },
            "description": "Lecturas registradas",
          },
        },
        "security": [
          {
            "bearerAuth": [],
          },
        ],
        "summary": "Registra lecturas de medidores en lote",
        "tags": [
          "Meters",
        ],
      },
    },
