          },
          "reportType": {
            "enum": [
              "attendance_summary",
              "overtime",
              "anomalies",
              "shift_coverage",
              "calendar",
              "detailed",
              "shift_report",
            ],
            "type": "string",
          },
        },
        "type": "object",
      },
      "SecurityInsights": {
        "properties": {
          "failedLogins24h": {
            "type": "number",
          },
          "lastAuditTimestamp": {
            "type": "string",
          },
          "lockedAccounts": {
            "type": "number",
          },
          "suspiciousIPs": {
            "items": {
              "type": "string",
            },
            "type": "array",
          },
        },
        "required": [
          "failedLogins24h",
          "lockedAccounts",
          "suspiciousIPs",
          "lastAuditTimestamp",
        ],
        "type": "object",
      },
      "SeedOptions": {
        "properties": {
          "adminPassword": {
            "type": "string",
          },
          "basePatternsCount": {
            "minimum": 1,
            "type": "integer",
          },
          "clearExisting": {
            "type": "boolean",
          },
          "correctionRequestRatio": {
            "maximum": 100,
            "minimum": 0,
            "type": "number",
          },
          "days": {
            "minimum": 0,
            "type": "integer",
          },
          "employees": {
            "minimum": 0,
            "type": "integer",
          },
          "leaveRatio": {
            "maximum": 100,
            "minimum": 0,
            "type": "number",
          },
          "monthsToSeed": {
            "maximum": 12,
            "minimum": 1,
            "type": "integer",
          },
          "quickNotesCount": {
            "minimum": 0,
            "type": "integer",
          },
          "seedEmployees": {
            "type": "boolean",
          },
          "seedRecords": {
            "type": "boolean",
          },
          "seedShifts": {
            "type": "boolean",
          },
          "shiftReportsPerDay": {
            "maximum": 6,
            "minimum": 0,
            "type": "number",
          },
        },
        "type": "object",
      },
      "SeedPhase2Job": {
        "properties": {
          "jobId": {
            "minLength": 1,
            "type": "string",
          },
        },
        "required": [
          "jobId",
        ],
        "type": "object",
      },
      "SeedPhase2Start": {
        "properties": {
          "batchSize": {
            "maximum": 2000,
            "minimum": 50,
            "type": "integer",
          },
          "correctionRequestRatio": {
            "maximum": 100,
            "minimum": 0,
            "type": "number",
          },
          "days": {
            "maximum": 3650,
            "minimum": 1,
            "type": "integer",
          },
          "leaveRatio": {
            "maximum": 100,
            "minimum": 0,
            "type": "number",
          },
        },
        "type": "object",
      },
      "SeedStatus": {
        "properties": {
          "currentPhase": {
            "type": "string",
          },
          "error": {
            "type": "string",
          },
          "processed": {
            "type": "number",
          },
          "progress": {
            "type": "number",
          },
          "startTime": {
            "type": "string",
          },
          "status": {
            "enum": [
              "idle",
              "running",
              "paused",
              "completed",
              "error",
            ],
            "type": "string",
          },
          "total": {
            "type": "number",
          },
        },
        "required": [
          "status",
          "progress",
          "processed",
          "total",
        ],
        "type": "object",
      },
      "SendTestEmail": {
        "additionalProperties": false,
        "properties": {
          "message": {
            "default": "",
            "type": "string",
          },
          "subject": {
            "default": "",
            "type": "string",
          },
          "to": {
            "format": "email",
            "type": "string",
          },
        },
        "required": [
          "to",
        ],
        "type": "object",
      },
      "ServerTime": {
        "properties": {
          "businessDate": {
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "type": "string",
          },
          "iso": {
            "type": "string",
          },
          "timestamp": {
            "type": "number",
          },
          "timezone": {
            "type": "string",
          },
        },
        "required": [
          "iso",
          "timestamp",
          "timezone",
          "businessDate",
        ],
        "type": "object",
      },
      "ShiftPattern": {
        "properties": {
          "color": {
            "type": "string",
          },
          "cycleLengthDays": {
            "minimum": 1,
            "type": "integer",
          },
          "dailySchedules": {
            "anyOf": [
              {
                "type": "string",
              },
              {
                "items": {
                  "$ref": "#/components/schemas/PatternSchedule",
                },
                "type": "array",
              },
            ],
          },
          "id": {
            "type": "string",
          },
          "isDeleted": {
            "type": "boolean",
          },
          "lastModified": {
            "type": "number",
          },
          "maxHoursPattern": {
            "type": "number",
          },
          "name": {
            "minLength": 2,
            "type": "string",
          },
          "startDayOfWeek": {
            "maximum": 6,
            "minimum": 0,
            "type": "integer",
          },
          "worksOnHolidays": {
            "type": "boolean",
          },
        },
        "required": [
          "name",
          "cycleLengthDays",
          "startDayOfWeek",
          "dailySchedules",
          "color",
          "maxHoursPattern",
        ],
        "type": "object",
      },
      "ShiftQuery": {
        "properties": {
          "employeeId": {
            "type": "string",
          },
          "endDate": {
            "type": "string",
          },
          "page": {
            "type": "string",
          },
          "pageSize": {
            "type": "string",
          },
          "startDate": {
            "type": "string",
          },
        },
        "type": "object",
      },
      "ShiftReport": {
        "properties": {
          "date": {
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "type": "string",
          },
          "endTime": {
            "nullable": true,
            "type": "string",
          },
          "folio": {
            "minLength": 1,
            "type": "string",
          },
          "id": {
            "type": "string",
          },
          "logEntries": {
            "items": {
              "properties": {
                "annotation": {
                  "minLength": 1,
                  "type": "string",
                },
                "id": {
                  "minLength": 1,
                  "type": "string",
                },
                "time": {
                  "minLength": 1,
                  "type": "string",
                },
                "timestamp": {
                  "type": "number",
                },
              },
              "required": [
                "id",
                "time",
                "annotation",
                "timestamp",
              ],
              "type": "object",
            },
            "type": "array",
          },
          "responsibleUser": {
            "minLength": 1,
            "type": "string",
          },
          "shiftName": {
            "minLength": 1,
            "type": "string",
          },
          "startTime": {
            "minLength": 1,
            "type": "string",
          },
          "status": {
            "enum": [
              "open",
              "closed",
            ],
            "type": "string",
          },
          "supplierEntries": {
            "items": {
              "properties": {
                "company": {
                  "minLength": 1,
                  "type": "string",
                },
                "driverName": {
                  "minLength": 1,
                  "type": "string",
                },
                "id": {
                  "minLength": 1,
                  "type": "string",
                },
                "licensePlate": {
                  "minLength": 1,
                  "type": "string",
                },
                "paxCount": {
                  "type": "number",
                },
                "reason": {
                  "minLength": 1,
                  "type": "string",
                },
                "time": {
                  "minLength": 1,
                  "type": "string",
                },
                "timestamp": {
                  "type": "number",
                },
              },
              "required": [
                "id",
                "time",
                "licensePlate",
                "driverName",
                "paxCount",
                "company",
                "reason",
                "timestamp",
              ],
              "type": "object",
            },
            "type": "array",
          },
        },
        "required": [
          "date",
          "folio",
          "shiftName",
          "responsibleUser",
          "startTime",
          "status",
          "logEntries",
          "supplierEntries",
        ],
        "type": "object",
      },
      "ShiftReportListResponse": {
        "allOf": [
          {
            "$ref": "#/components/schemas/ApiResponse",
          },
          {
            "properties": {
              "data": {
                "items": {
                  "$ref": "#/components/schemas/ShiftReport",
                },
                "type": "array",
              },
            },
            "required": [
              "data",
            ],
            "type": "object",
          },
        ],
      },
      "SuggestedPatternName": {
        "properties": {
