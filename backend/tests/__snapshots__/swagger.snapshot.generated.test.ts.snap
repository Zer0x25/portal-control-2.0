    "/api/audit-logs": {
      "get": {
        "parameters": [
          {
            "in": "query",
            "name": "page",
            "schema": {
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "pageSize",
            "schema": {
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "category",
            "schema": {
              "type": "string",
            },
          },
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuditLogListResponse",
                },
              },
            },
            "description": "Lista de logs de auditoría",
          },
        },
        "security": [
          {
            "bearerAuth": [],
