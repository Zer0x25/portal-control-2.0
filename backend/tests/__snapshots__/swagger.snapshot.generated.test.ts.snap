          "SinMarcajeTurnoAsignado",
          "Feriado",
        ],
        "type": "string",
      },
      "TimeRecordWrite": {
        "properties": {
          "date": {
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "type": "string",
          },
          "employeeId": {
            "minLength": 1,
            "type": "string",
          },
          "entrada": {
            "nullable": true,
            "type": "string",
          },
          "finColacion": {
            "nullable": true,
            "type": "string",
          },
          "inicioColacion": {
            "nullable": true,
            "type": "string",
          },
          "justification": {
            "nullable": true,
            "type": "string",
          },
          "salida": {
            "nullable": true,
            "type": "string",
          },
          "source": {
            "type": "string",
          },
          "status": {
            "type": "string",
          },
        },
        "required": [
