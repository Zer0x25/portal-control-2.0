{
  "name": "backend",
  "version": "8.18.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "set DISABLE_INTEGRITY_AUDIT=true&& ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:status": "prisma migrate status",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "check": "tsc --noEmit",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "set NODE_OPTIONS=--max-old-space-size=4096&& vitest run tests/unit tests/*.test.ts --silent",
    "test:coverage": "vitest run --coverage tests/unit tests/*.test.ts --silent",
    "test:unit:ci": "node scripts/run-unit-tests.cjs",
    "test:integration": "node scripts/run-integration-tests.cjs",
    "test:integration:ci": "node scripts/run-integration-tests.cjs",
    "test:pollution:pre": "npx tsx scripts/test-pollution-guard.ts pre",
    "test:pollution:post": "npx tsx scripts/test-pollution-guard.ts post",
    "test:schemas-refactor": "vitest run tests/schema.smoke.test.ts tests/exports.compat.test.ts tests/swagger.snapshot.generated.test.ts",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" \"scripts/**/*.{ts,cjs}\" \"*.{json,md,yml,yaml}\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\" \"scripts/**/*.{ts,cjs}\" \"*.{json,md,yml,yaml}\"",
    "validate:quick": "npm run check && npm run test:schemas-refactor",
    "validate:ci": "npm run format:check && npm run lint && node ../scripts/lint-budget.cjs --only backend && npm run check && npm run check:sdk && npm run test:schemas-refactor && npm run build",
    "validate:full": "npm run lint && npm run check && npm test && npm run build",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "docs:generate": "npx tsx scripts/generate-swagger.ts",
    "verify:kpi": "npx ts-node scripts/verify_kpi_sync.ts",
    "check:sdk": "npx tsx scripts/verify-sdk-sync.ts",
    "integrity:backfill": "npx tsx scripts/backfill_time_record_integrity.ts",
    "shift-reports:normalize": "npx tsx scripts/normalize_shift_reports.ts",
    "stress:records": "npx tsx scripts/stress_time_records.ts",
    "db:reset:state": "npx tsx scripts/reset-to-snapshot.ts",
    "benchmark:monthly-plan": "npx tsx scripts/benchmark_monthly_plan.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^9.1.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@sentry/node": "^11.4.0",
    "@sentry/profiling-node": "^11.4.0",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "dotenv": "^18.0.4",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.0.2",
    "nodemailer": "^10.0.12",
    "pdfkit": "^0.20.2",
    "pg": "^8.18.0",
    "pg-cursor": "^2.17.0",
    "qrcode": "^1.5.4",
    "rate-limiter-flexible": "^11.2.1",
    "socket.io": "^4.8.3",
    "speakeasy": "^2.0.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.2",
    "typescript": "^5.3.3",
    "ulid": "^3.0.2",
    "yaml": "^2.8.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/exceljs": "^1.3.2",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.19.1",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "^0.17.4",
    "@types/pg": "^8.16.0",
    "@types/qrcode": "^1.5.6",
    "@types/speakeasy": "^2.0.10",
    "@types/supertest": "^7.2.1",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "globals": "^17.3.0",
    "prettier": "^3.8.1",
    "prisma": "^7.10.0",
    "supertest": "^7.3.0",
    "ts-node-dev": "^2.0.0",
    "vitest": "^5.0.3"
  },
  "prisma": {
    "seed": "npx tsx prisma/seed.ts"
  }
}
